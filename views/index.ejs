<% locals.page = "home" %>
<%- layout("/layouts/boilerplate") %>


<div class="container homepage">

    <!-- ================= HERO ================= -->

    <section class="hero-section text-center py-5">

        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">
            <i class="fa-solid fa-shield-halved me-2"></i>
            AI Powered Security Platform
        </span>

        <h1 class="hero-title">
            Paper Secured System
        </h1>

        <p class="hero-description">
            Protect examination papers using AES-256 Encryption, SHA-256 Integrity Verification,
            JWT Authentication, Device Fingerprinting, Live Monitoring and AI-based Leak Prediction.
        </p>

        <% if(loggedIn){ %>

        <div class="welcome-box">
            <i class="fa-solid fa-circle-check me-2"></i>

            Welcome back,

            <strong><%= role %></strong>

            <span class="text-muted ms-2">
                Your secure examination environment is ready.
            </span>
        </div>

        <% } %>

    </section>



    <!-- ================= SECURITY STATUS ================= -->

    <section class="mt-5">

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-lock"></i>

                        </div>

                        <h5>Encryption</h5>

                        <p class="text-muted small">
                            AES-256 Military Grade Encryption
                        </p>

                        <span class="badge bg-success px-3 py-2">
                            ACTIVE
                        </span>

                    </div>

                </div>

            </div>



            <div class="col-lg-3 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-file-shield"></i>

                        </div>

                        <h5>Integrity</h5>

                        <p class="text-muted small">
                            SHA-256 Verification
                        </p>

                        <span class="badge bg-success px-3 py-2">
                            VERIFIED
                        </span>

                    </div>

                </div>

            </div>



            <div class="col-lg-3 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-fingerprint"></i>

                        </div>

                        <h5>Authentication</h5>

                        <p class="text-muted small">
                            Device Fingerprinting
                        </p>

                        <span class="badge bg-success px-3 py-2">
                            ENABLED
                        </span>

                    </div>

                </div>

            </div>



            <div class="col-lg-3 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-shield-halved"></i>

                        </div>

                        <h5>Protection</h5>

                        <p class="text-muted small">
                            AI Threat Monitoring
                        </p>

                        <span class="badge bg-success px-3 py-2">
                            MONITORING
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= BUTTONS ================= -->

    <section class="hero-buttons">

        <% if(!loggedIn){ %>

        <a href="/auth/login"
           class="btn btn-primary btn-lg px-5 me-3">

            Login

        </a>

        <a href="/auth/register"
           class="btn btn-outline-primary btn-lg px-5">

            Register

        </a>

        <% } else { %>

        <a href="/auth/history"
           class="btn btn-success btn-lg px-5 me-3">

            <i class="fa-solid fa-chart-line me-2"></i>

            Dashboard

        </a>

        <form action="/auth/logout"
              method="POST"
              class="d-inline">

            <button class="btn btn-outline-danger btn-lg px-5">

                Logout

            </button>

        </form>

        <% } %>

    </section>



    <!-- ================= FEATURES ================= -->

    <section class="mt-5">

        <div class="section-heading text-center">

            <h2 class="fw-bold">
                Security Features
            </h2>

            <p class="text-muted">
                Advanced technologies protecting your examination lifecycle.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="card feature-card h-100">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-lock"></i>

                        </div>

                        <h5>End-to-End Encryption</h5>

                        <p class="text-muted">

                            Papers remain encrypted before storage and during transmission.

                        </p>

                    </div>

                </div>

            </div>



            <div class="col-lg-4">

                <div class="card feature-card h-100">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-key"></i>

                        </div>

                        <h5>Secure Token Access</h5>

                        <p class="text-muted">

                            Students receive time-limited secure examination tokens.

                        </p>

                    </div>

                </div>

            </div>



            <div class="col-lg-4">

                <div class="card feature-card h-100">

                    <div class="card-body">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-eye"></i>

                        </div>

                        <h5>AI Monitoring</h5>

                        <p class="text-muted">

                            Continuous monitoring detects suspicious behaviour in real time.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= WORKFLOW ================= -->

    <div class="card workflow-card">

        <div class="card shadow-sm">

            <div class="card-body p-5">

                <h2 class="text-center fw-bold mb-5">

                    Examination Workflow

                </h2>

                <div class="row text-center">

                    <div class="col-md-3 workflow-step">

                        <div class="workflow-icon">

                            <i class="fa-solid fa-upload"></i>

                        </div>

                        <h5>Upload</h5>

                        <p class="text-muted">
                            Teacher securely uploads examination paper.
                        </p>

                    </div>

                    <div class="col-md-3 workflow-step">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-user-check"></i>

                        </div>

                        <h5>Review</h5>

                        <p class="text-muted">
                            Reviewer verifies paper integrity.
                        </p>

                    </div>

                    <div class="col-md-3 workflow-step">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-key"></i>

                        </div>

                        <h5>Access</h5>

                        <p class="text-muted">
                            Students authenticate using secure tokens.
                        </p>

                    </div>

                    <div class="col-md-3 workflow-step">

                        <div class="feature-icon mb-3">

                            <i class="fa-solid fa-shield-halved"></i>

                        </div>

                        <h5>Protected Exam</h5>

                        <p class="text-muted">
                            AI continuously monitors examination security.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>


