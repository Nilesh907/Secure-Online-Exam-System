<% locals.page = "papers" %>
<%- layout("/layouts/boilerplate") %>

<!-- Bootstrap CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
  <div class="card shadow-lg p-4">

    <h2 class="mb-4 text-center">Create Paper</h2>

    <form action="/papers" method="POST" enctype="multipart/form-data">

      <!-- BASIC DETAILS -->
      <div class="row mb-3">
        <div class="col">
          <label class="form-label">Title</label>
          <input type="text" name="paper[title]" class="form-control" required>
        </div>

        <div class="col">
          <label class="form-label">Description</label>
          <input type="text" name="paper[description]" class="form-control" required>
        </div>

        <div class="col">
          <label class="form-label">Subject</label>
          <input type="text" name="paper[subject]" class="form-control" required>
        </div>
      </div>

      <div class="row mb-3">
        <div class="col">
          <label class="form-label">Department</label>
          <input type="text" name="paper[department]" class="form-control" required>
        </div>

        <div class="col">
  <label class="form-label">
    Classification
  </label>

  <select
    name="paper[classification]"
    class="form-select"
  >
      <option value="PUBLIC">
        Public
      </option>

      <option value="INTERNAL">
        Internal
      </option>

      <option value="CONFIDENTIAL">
        Confidential
      </option>

      <option value="EXAM_CONFIDENTIAL" selected>
        Exam Confidential
      </option>

  </select>
</div>

            <label class="form-label">
      Upload PDF
    </label>

    <input
      type="file"
      name="paper"
      class="form-control"
      accept=".pdf"
      required
    >

      <small class="text-muted">
        PDF only (Max 10MB)
      </small>
      <hr>
      <!-- BUTTON -->
      <div class="text-center mt-4">
        <button type="submit" class="btn btn-primary px-5">Create Paper</button>
      </div>

    </form>
  </div>
</div>