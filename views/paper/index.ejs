<% locals.page = "papers" %>
<% locals.title = "Paper Management" %>

<%- layout("/layouts/boilerplate") %>

<!-- ================= HEADER ================= -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="page-title mb-1">

            Paper Management

        </h2>

        <p class="text-muted mb-0">

            Manage, review and securely access examination papers.

        </p>

    </div>

    <% if(currentUser?.role==="Admin" || currentUser?.role==="Teacher"){ %>

        <a href="/papers/new" class="btn btn-add">

            <i class="fa-solid fa-upload me-2"></i>

            Upload Paper

        </a>

    <% } %>

</div>

<!-- ================= TABLE ================= -->

<div class="card">

<div class="table-responsive">

<table class="table table-hover align-middle">

<thead>

<tr>

<th>Title</th>

<th>Subject</th>

<th>Department</th>

<th>Status</th>

<th>Uploaded By</th>

<th>Reviewed By</th>

<th>Last Viewed</th>

<th>Created</th>

<th class="text-center">Actions</th>

</tr>

</thead>

<tbody>

<% if(papers.length===0){ %>

<tr>

<td colspan="9" class="text-center no-data">

<i class="fa-regular fa-folder-open fa-2x mb-3 text-secondary"></i>

<br>

No papers available.

</td>

</tr>

<% } %>

<% papers.forEach(p=>{ %>

<tr>

<!-- Title -->

<td>

<strong>

<%= p.title %>

</strong>

</td>

<!-- Subject -->

<td>

<%= p.subject %>

</td>

<!-- Department -->

<td>

<%= p.department %>

</td>

<!-- Status -->

<td>

<span class="badge

<%= p.status==="APPROVED"

? "badge-approved"

: p.status==="UNDER_REVIEW"

? "badge-review"

: p.status==="NEEDS_CORRECTION"

? "badge-correction"

: "badge-draft"

%>">

<%= p.status.replaceAll("_"," ") %>

</span>

</td>

<!-- Uploaded -->

<td>

<%= p.uploadedBy?.name || "N/A" %>

</td>

<!-- Reviewed -->

<td>

<%= p.reviewedBy?.name || "N/A" %>

</td>

<!-- Last Viewed -->

<td>

<%= p.lastViewedAt

? new Date(p.lastViewedAt).toLocaleString("en-IN",{

dateStyle:"medium",

timeStyle:"short"

})

: "Never"

%>

</td>

<!-- Created -->

<td>

<%= p.createdAt

? new Date(p.createdAt).toLocaleDateString("en-IN")

: "N/A"

%>

</td>

<!-- Actions -->

<td>

<div class="paper-actions">

<% const now=new Date(); %>

<!-- ================= STUDENT ================= -->

<% if(currentUser?.role==="Student"){ %>

<a href="/papers/<%= p._id %>" class="btn btn-view btn-sm">

<i class="fa-solid fa-eye me-1"></i>

View

</a>

<% if(

p.status==="APPROVED"

&& p.startTime

&& p.endTime

&& now>=p.startTime

&& now<=p.endTime

){ %>

<a href="/exam/<%= p._id %>/token"

class="btn btn-success btn-sm">

<i class="fa-solid fa-key me-1"></i>

Token

</a>

<% }else{ %>

<button class="btn btn-secondary btn-sm" disabled>

Unavailable

</button>

<% } %>

<% } %>

<!-- ================= ADMIN / TEACHER ================= -->

<% if(currentUser?.role==="Admin" || currentUser?.role==="Teacher"){ %>

<a href="/papers/<%= p._id %>"
   class="btn btn-view btn-sm">

    <i class="fa-solid fa-eye me-1"></i>

    View

</a>

<a href="/papers/<%= p._id %>/edit"
   class="btn btn-edit btn-sm">

    <i class="fa-solid fa-pen-to-square me-1"></i>

    Edit

</a>

<form
    action="/papers/<%= p._id %>?_method=DELETE"
    method="POST"
    class="d-inline">

    <button
        class="btn btn-delete btn-sm"
        onclick="return confirm('Delete this paper?')">

        <i class="fa-solid fa-trash me-1"></i>

        Delete

    </button>

</form>

<% } %>

</div>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>