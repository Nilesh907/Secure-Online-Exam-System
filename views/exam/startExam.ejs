
<% locals.page = "start-exam" %>
<%- layout("/layouts/boilerplate") %>


<div class="row justify-content-center">
  <div class="col-md-6">

    <div class="card p-4 text-center shadow-lg border-0">

      <h4 class="mb-3">Ready to Start</h4>

      <p class="text-muted">
        Your token has been verified successfully.
      </p>

      <form action="/exam/<%= paper._id %>/start" method="POST">
        <input type="hidden" name="token" value="<%= token %>">

        <button class="btn btn-success w-100">
          Start Exam
        </button>
      </form>

    </div>

  </div>
</div>