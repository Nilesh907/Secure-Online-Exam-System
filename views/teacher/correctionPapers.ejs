<% locals.page = "teachers" %>
<%- layout("/layouts/boilerplate") %>



<div class="container mt-4">

  <h2 class="page-title mb-4">
    Papers Needing Correction
  </h2>

  <% if (papers.length === 0) { %>
    <div class="alert alert-success">
      No papers need correction
    </div>
  <% } %>

  <% papers.forEach(function(paper) => { %>

    <div class="card p-4 mb-4 shadow-sm">

      <h4><%= paper.title %></h4>

      <p><strong>Status:</strong> 
        <span class="badge bg-danger">
          <%= paper.status %>
        </span>
      </p>

      
      <div class="alert alert-warning">
         Reviewer found issues. Please fix and resubmit.
      </div>

      
      <div class="mb-3">
        <label><strong>Reviewer Comment:</strong></label>
        <textarea class="form-control" readonly>
        <%= paper.reviewComment || "NO COMMENT " %>
        </textarea>
      </div>

      
      <div class="d-flex gap-2">

        <!-- EDIT -->
        <a href="/papers/<%= paper._id %>/edit" 
           class="btn btn-warning">
          Edit Paper
        </a>

        <!-- RESUBMIT -->
        <form action="/papers/<%= paper._id %>/submit" method="POST">
          <button class="btn btn-success">
            Resubmit
          </button>
        </form>

      </div>

    </div>

  <% }) %>

</div>