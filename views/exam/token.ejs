<% locals.page = "token" %>
<%- layout("/layouts/boilerplate") %>


<div class="row justify-content-center">
  <div class="col-md-6">

    <div class="card p-4 text-center shadow-lg border-0">

      <h4 class="mb-3"><%= paper.title %></h4>

      <% if (!token) { %>

        <p class="text-muted">Click below to generate your secure exam token</p>

        <form action="/exam/<%= paper._id %>/generate-token" method="POST">
          <button class="btn btn-primary w-100">
            Generate Token
          </button>
        </form>

      <% } %>

      <% if (token) { %>

        <p class="mt-3 fw-bold text-success">Your Token:</p>

        <div class="bg-light p-3 rounded border mb-3 small text-break">
          <%= token %>
        </div>

        <form action="/exam/<%= paper._id %>/start" method="POST">
          <input type="hidden" name="token" value="<%= token %>">

          <button class="btn btn-success w-100">
            Start Exam
          </button>
        </form>

      <% } %>

    </div>

  </div>
</div>