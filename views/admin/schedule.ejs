<% locals.page = "admin" %>
<%- layout("/layouts/boilerplate") %>

<!-- Bootstrap CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">


<div class="container mt-5">

  <div class="card shadow-lg p-4">

    <h2 class="mb-4 text-center">
      Schedule Exam
    </h2>

    <form
      action="/admin/papers/<%= paper._id %>/schedule"
      method="POST"
    >

      <!-- Paper Info -->

      <div class="mb-3">
        <label class="form-label">
          Paper Title
        </label>

        <input
          type="text"
          class="form-control"
          value="<%= paper.title %>"
          readonly
        >
      </div>

      <div class="mb-3">
        <label class="form-label">
          Subject
        </label>

        <input
          type="text"
          class="form-control"
          value="<%= paper.subject %>"
          readonly
        >
      </div>

      <!-- Start Time -->

      <div class="mb-3">
        <label class="form-label">
          Start Time
        </label>

        <input
          type="datetime-local"
          name="startTime"
          class="form-control"
          required
        >
      </div>

      <!-- End Time -->

      <div class="mb-3">
        <label class="form-label">
          End Time
        </label>

        <input
          type="datetime-local"
          name="endTime"
          class="form-control"
          required
        >
      </div>

      <!-- Duration -->

      <div class="mb-3">
        <label class="form-label">
          Duration (Minutes)
        </label>

        <input
          type="number"
          class="form-control"
          value="60"
          readonly
        >
      </div>

      <button
        class="btn btn-warning w-100"
      >
        Schedule Exam
      </button>

    </form>

  </div>

</div>