<% locals.page = "reviewers" %>
<%- layout("/layouts/boilerplate") %>



<div class="edit-container">

<h2>Edit Reviewer</h2>

<form action="/reviewers/<%= reviewer._id %>?_method=PUT" method="POST" class="form-box">

<div class="form-group">
<label>Reviewer ID</label>
<input type="text" name="reviewerId" value="<%= reviewer.reviewerId %>" required>
</div>

<div class="form-group">
<label>Department</label>
<input type="text" name="department" value="<%= reviewer.department %>" required>
</div>

<div class="form-group">
<label>Status</label>
<select name="status">

<option value="DRAFT" <%= reviewer.status === "DRAFT" ? "selected" : "" %>>DRAFT</option>

<option value="UNDER_REVIEW" <%= reviewer.status === "UNDER_REVIEW" ? "selected" : "" %>>UNDER REVIEW</option>

<option value="APPROVED" <%= reviewer.status === "APPROVED" ? "selected" : "" %>>APPROVED</option>

</select>
</div>

<div class="form-group">
<label>Availability</label>
<select name="availability">

<option value="AVAILABLE" <%= reviewer.availability === "AVAILABLE" ? "selected" : "" %>>AVAILABLE</option>

<option value="BUSY" <%= reviewer.availability === "BUSY" ? "selected" : "" %>>BUSY</option>

<option value="INACTIVE" <%= reviewer.availability === "INACTIVE" ? "selected" : "" %>>INACTIVE</option>

</select>
</div>

<div class="form-group">
<label>Max Assignments</label>
<input type="number" name="maxAssignments" min="1" max="10" value="<%= reviewer.maxAssignments %>">
</div>

<button class="btn-save">Update Reviewer</button>

</form>

</div>