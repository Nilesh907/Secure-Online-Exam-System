<% locals.page = "teachers" %>
<% locals.title = "Teacher Management" %>

<%- layout("/layouts/boilerplate") %>

<!-- ================= HEADER ================= -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="page-title mb-1">

            Teacher Management

        </h2>

        <p class="text-muted mb-0">

            Manage teacher profiles, departments and academic information.

        </p>

    </div>

    <a href="/teachers/new" class="btn btn-add">

        <i class="fa-solid fa-user-plus me-2"></i>

        Add Teacher

    </a>

</div>

<!-- ================= TABLE ================= -->

<div class="card">

<div class="table-responsive">

<table class="table table-hover align-middle">

<thead>

<tr>

<th>Name</th>

<th>Email</th>

<th>Teacher ID</th>

<th>Department</th>

<th>Designation</th>

<th>Qualification</th>

<th>Experience</th>

<th class="text-center">Actions</th>

</tr>

</thead>

<tbody>

<% if(teachers.length===0){ %>

<tr>

<td colspan="8" class="text-center no-data">

<i class="fa-solid fa-chalkboard-user fa-2x mb-3 text-secondary"></i>

<br>

No teachers found.

</td>

</tr>

<% } %>

<% teachers.forEach(t=>{ %>

<tr>

<!-- Name -->

<td>

<strong>

<%= t.user?.name || "N/A" %>

</strong>

</td>

<!-- Email -->

<td>

<%= t.user?.email || "N/A" %>

</td>

<!-- Teacher ID -->

<td>

<span class="badge badge-teacher">

<%= t.teacherId %>

</span>

</td>

<!-- Department -->

<td>

<%= t.department %>

</td>

<!-- Designation -->

<td>

<%= t.designation %>

</td>

<!-- Qualification -->

<td>

<%= t.qualification %>

</td>

<!-- Experience -->

<td>

<%= t.experienceYears %> Years

</td>

<!-- Actions -->

<td>

<div class="paper-actions">

<a href="/teachers/<%= t._id %>"

class="btn btn-view btn-sm">

<i class="fa-solid fa-eye me-1"></i>

View

</a>

<a href="/teachers/<%= t._id %>/edit"

class="btn btn-edit btn-sm">

<i class="fa-solid fa-pen-to-square me-1"></i>

Edit

</a>

<form

action="/teachers/<%= t._id %>?_method=DELETE"

method="POST"

class="d-inline">

<button

type="submit"

class="btn btn-delete btn-sm"

onclick="return confirm('Delete this teacher?')">

<i class="fa-solid fa-trash me-1"></i>

Delete

</button>

</form>

</div>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>